{
  "stages": {
    "backlog":        {"role": "intake"},
    "triage":         {"role": "intake"},
    "spec":           {"role": "definition"},
    "design":         {"role": "definition"},
    "design-review":  {"role": "review"},
    "implement":      {"role": "work"},
    "code-review":    {"role": "review"},
    "test":           {"role": "work"},
    "verify":         {"role": "review"},
    "done":           {"role": "terminal"}
  },
  "stage_order": [
    "backlog", "triage", "spec", "design", "design-review",
    "implement", "code-review", "test", "verify", "done"
  ],
  "pipelines": {
    "feature": {
      "default": ["backlog", "triage", "spec", "design", "implement", "test", "verify", "done"],
      "low":      ["backlog", "triage", "spec", "design", "implement", "test", "verify", "done"],
      "normal":   ["backlog", "triage", "spec", "design", "design-review", "implement", "code-review", "test", "verify", "done"],
      "high":     ["backlog", "triage", "spec", "design", "design-review", "implement", "code-review", "test", "verify", "done"],
      "critical": ["backlog", "triage", "spec", "design", "design-review", "implement", "code-review", "test", "verify", "done"]
    },
    "bug": {
      "default": ["backlog", "triage", "implement", "test", "verify", "done"],
      "low":     ["backlog", "triage", "implement", "verify", "done"],
      "normal":  ["backlog", "triage", "implement", "code-review", "test", "verify", "done"],
      "high":    ["backlog", "triage", "implement", "code-review", "test", "verify", "done"],
      "critical":["backlog", "triage", "implement", "code-review", "test", "verify", "done"]
    },
    "task": {
      "default": ["backlog", "triage", "implement", "test", "verify", "done"],
      "low":     ["backlog", "triage", "implement", "verify", "done"],
      "normal":  ["backlog", "triage", "implement", "code-review", "test", "verify", "done"],
      "high":    ["backlog", "triage", "implement", "code-review", "test", "verify", "done"],
      "critical":["backlog", "triage", "implement", "code-review", "test", "verify", "done"]
    },
    "chore": {
      "default": ["backlog", "triage", "implement", "verify", "done"],
      "low":     ["backlog", "triage", "implement", "verify", "done"],
      "normal":  ["backlog", "triage", "implement", "verify", "done"],
      "high":    ["backlog", "triage", "implement", "verify", "done"],
      "critical":["backlog", "triage", "implement", "verify", "done"]
    },
    "epic": {
      "default": ["backlog", "triage", "spec", "design", "done"],
      "low":     ["backlog", "triage", "spec", "design", "done"],
      "normal":  ["backlog", "triage", "spec", "design", "done"],
      "high":    ["backlog", "triage", "spec", "design", "done"],
      "critical":["backlog", "triage", "spec", "design", "done"]
    }
  },
  "gates": {
    "backlog>triage": {
      "structural": ["description_exists", "priority_set", "risk_set"]
    },
    "triage>spec": {
      "structural": ["description_exists"]
    },
    "triage>implement": {
      "structural": ["description_exists"]
    },
    "spec>design": {
      "structural": ["acceptance_exists", "review_approved"]
    },
    "design>design-review": {
      "structural": ["design_exists"]
    },
    "design>implement": {
      "structural": ["design_exists", "review_approved"]
    },
    "design-review>implement": {
      "structural": ["review_approved"]
    },
    "implement>code-review": {
      "agentic": ["Implementation follows the approved design", "Code compiles and passes existing tests"]
    },
    "implement>test": {
      "structural": ["code_review_approved", "impl_review_approved"]
    },
    "code-review>test": {
      "structural": ["review_approved"]
    },
    "test>verify": {
      "structural": ["test_results_recorded"]
    },
    "verify>done": {
      "structural": ["review_approved"]
    },
    "design>done": {
      "structural": ["design_exists", "review_approved"]
    }
  }
}
